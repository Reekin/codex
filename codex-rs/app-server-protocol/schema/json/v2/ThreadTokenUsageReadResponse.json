{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ThreadContextUsage": {
      "description": "Active model context usage; `tokens` is the value that drives automatic compaction.",
      "properties": {
        "autoCompactTokenLimit": {
          "description": "Active context tokens at which automatic compaction triggers, when it can trigger.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "breakdown": {
          "allOf": [
            {
              "$ref": "#/definitions/ThreadContextUsageBreakdown"
            }
          ],
          "description": "Estimated composition of `tokens`; categories sum exactly to `tokens`."
        },
        "tokens": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "breakdown",
        "tokens"
      ],
      "type": "object"
    },
    "ThreadContextUsageBreakdown": {
      "properties": {
        "agentMessages": {
          "format": "int64",
          "type": "integer"
        },
        "agentsMd": {
          "format": "int64",
          "type": "integer"
        },
        "baseInstructions": {
          "format": "int64",
          "type": "integer"
        },
        "compaction": {
          "format": "int64",
          "type": "integer"
        },
        "developerInstructions": {
          "format": "int64",
          "type": "integer"
        },
        "environment": {
          "format": "int64",
          "type": "integer"
        },
        "other": {
          "format": "int64",
          "type": "integer"
        },
        "reasoning": {
          "format": "int64",
          "type": "integer"
        },
        "skills": {
          "format": "int64",
          "type": "integer"
        },
        "toolCalls": {
          "format": "int64",
          "type": "integer"
        },
        "tools": {
          "format": "int64",
          "type": "integer"
        },
        "userMessages": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "agentMessages",
        "agentsMd",
        "baseInstructions",
        "compaction",
        "developerInstructions",
        "environment",
        "other",
        "reasoning",
        "skills",
        "toolCalls",
        "tools",
        "userMessages"
      ],
      "type": "object"
    },
    "ThreadTokenUsage": {
      "properties": {
        "contextUsage": {
          "anyOf": [
            {
              "$ref": "#/definitions/ThreadContextUsage"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Active context usage; absent for snapshots recorded without it."
        },
        "last": {
          "$ref": "#/definitions/TokenUsageBreakdown"
        },
        "modelContextWindow": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "total": {
          "$ref": "#/definitions/TokenUsageBreakdown"
        }
      },
      "required": [
        "last",
        "total"
      ],
      "type": "object"
    },
    "TokenUsageBreakdown": {
      "properties": {
        "cacheWriteInputTokens": {
          "default": 0,
          "format": "int64",
          "type": "integer"
        },
        "cachedInputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "inputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "outputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "reasoningOutputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "totalTokens": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "cachedInputTokens",
        "inputTokens",
        "outputTokens",
        "reasoningOutputTokens",
        "totalTokens"
      ],
      "type": "object"
    },
    "TurnTokenUsage": {
      "properties": {
        "tokenUsage": {
          "$ref": "#/definitions/ThreadTokenUsage"
        },
        "turnId": {
          "type": "string"
        }
      },
      "required": [
        "tokenUsage",
        "turnId"
      ],
      "type": "object"
    }
  },
  "properties": {
    "data": {
      "description": "The last token usage recorded in each turn of the thread's own history, in turn order.",
      "items": {
        "$ref": "#/definitions/TurnTokenUsage"
      },
      "type": "array"
    }
  },
  "required": [
    "data"
  ],
  "title": "ThreadTokenUsageReadResponse",
  "type": "object"
}